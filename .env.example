# Server Configuration
PORT=5001
NODE_ENV=production

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Security
JWT_SECRET=your_jwt_secret

# Redirect URLs
EMAIL_CONFIRM_REDIRECT_URL=https://your-frontend-domain.com/auth/confirm
PASSWORD_RESET_REDIRECT_URL=https://your-frontend-domain.com/auth/reset-password
